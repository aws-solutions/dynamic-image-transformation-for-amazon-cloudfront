# DynamoDB Local on Amazon Linux 2023 Minimal + Corretto 17
# Built from tar.gz instead of official Docker image to:
#   - Eliminate Python/pip/setuptools CVEs (not present in AL2023 minimal)
#
# Java dependency CVE posture:
#   DDBLocal 3.3.0 shipped several outdated dependency JARs that we hand-patched.
#   3.3.1 bundles equal-or-newer fixed versions for all of them, so no in-image
#   JAR patching is required. For reference, the CVEs previously patched and the
#   version now bundled by 3.3.1:
#     - jackson-core   GHSA-72hv-8253-57qq (async parser DoS)   -> 2.21.5 bundled
#     - jetty-server   CVE-2026-1605 (JDK Inflater DoS)         -> 12.1.11 bundled
#     - kotlin-stdlib  CVE-2022-24329 (dependency lock bypass)  -> 1.9.21 bundled
#     - netty          (transitive fixes)                       -> 4.1.135.Final bundled
#   If a future CVE requires patching again, note that DynamoDBLocal.jar's
#   MANIFEST.MF Class-Path references dependency JARs by filename: Netty uses
#   version-stripped names (netty-*-4.1.x.jar), non-Netty JARs embed the full
#   version. Java resolves by classpath entry, so replacing the file contents at
#   the manifest's filename loads the new JAR; Trivy/cdxgen read the JAR's internal
#   MANIFEST.MF, so they see the patched version regardless of filename.

FROM public.ecr.aws/amazonlinux/amazonlinux:minimal

# Install only the headless JRE + tools — minimal base has no Python, no pip, no setuptools
# curl-minimal is pre-installed in the minimal base image
RUN dnf install -y java-17-amazon-corretto-headless tar gzip && \
    dnf clean all && rm -rf /var/cache/dnf

# DynamoDB Local 3.3.1 — pinned via SHA256 checksum.
# The URL is the floating "latest" alias, so this checksum is what pins the version.
# If DDBLocal releases a new version, this build fails loudly at the sha256sum check
# rather than silently pulling an unreviewed release.
# To update: download the new tar.gz, re-scan its bundled JARs for CVEs (re-adding
# patches only if upstream regressed a dependency), then update the version + checksum.
ARG DDBLOCAL_VERSION=3.3.1
ARG DDBLOCAL_SHA256=f80bcec477f85f57e2c77f8d54aa6b672a8403fceff0c450560aee1cf6c21163

ARG DDBLOCAL_URL=https://d1ni2b6xgvw0s0.cloudfront.net/v2.x/dynamodb_local_latest.tar.gz

WORKDIR /home/dynamodblocal

# Download and verify DynamoDB Local
RUN curl -fSL -o dynamodb_local_latest.tar.gz "${DDBLOCAL_URL}" && \
    echo "${DDBLOCAL_SHA256}  dynamodb_local_latest.tar.gz" | sha256sum -c - && \
    tar xzf dynamodb_local_latest.tar.gz && \
    rm -f dynamodb_local_latest.tar.gz

EXPOSE 8000

ENTRYPOINT ["java", "-Djava.library.path=./DynamoDBLocal_lib", "-jar", "DynamoDBLocal.jar"]
CMD ["-sharedDb", "-inMemory"]
